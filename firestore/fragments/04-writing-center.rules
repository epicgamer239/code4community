
      function isSlotHost() {
        return isTutor() || isTeacherOrAdmin() || isAdminByEmail();
      }

      function isValidSlotType(t) {
        return t in ['tutoring', 'remediation', 'retake', 'office_hours'];
      }

      function isValidSlotStatus(s) {
        return s in ['open', 'full', 'closed', 'cancelled'];
      }

      function isWritingCenterTimestamp(value) {
        return value is timestamp ||
          (value is string && value.size() > 0 && value.size() <= 40);
      }

      function isValidWritingCenterSessionType(t) {
        return t in ['IN_PERSON', 'ASYNC', 'MINI_LESSON'];
      }

      function isAdminMiniLessonCreate() {
        return isAnyAdmin() &&
          request.resource.data.sessionType == 'MINI_LESSON' &&
          request.resource.data.status == 'COMPLETED' &&
          request.resource.data.studentId == 'wc-mini-lesson' &&
          request.resource.data.studentName is string &&
          request.resource.data.studentName.size() > 0 &&
          request.resource.data.studentEmail is string &&
          request.resource.data.subject is string &&
          request.resource.data.subject.size() > 0 &&
          request.resource.data.notes is string &&
          request.resource.data.tutorIds is list &&
          request.resource.data.tutorIds.size() > 0 &&
          request.resource.data.tutorIds.size() <= 30 &&
          request.resource.data.tutorId is string &&
          request.resource.data.tutorId.size() > 0 &&
          request.resource.data.tutorName is string &&
          request.resource.data.tutorName.size() > 0 &&
          request.resource.data.teacherId is string &&
          request.resource.data.teacherId.size() > 0 &&
          request.resource.data.teacherName is string &&
          request.resource.data.teacherName.size() > 0 &&
          isWritingCenterTimestamp(request.resource.data.createdAt) &&
          isWritingCenterTimestamp(request.resource.data.updatedAt);
      }

      function isMiniLessonOverseeingTeacher() {
        return isAuthenticated() &&
          resource.data.sessionType == 'MINI_LESSON' &&
          resource.data.teacherId == request.auth.uid;
      }

      function isMiniLessonTeacherReportUpdate() {
        return isMiniLessonOverseeingTeacher() &&
          request.resource.data.sessionType == resource.data.sessionType &&
          request.resource.data.teacherId == resource.data.teacherId &&
          request.resource.data.tutorId == resource.data.tutorId &&
          request.resource.data.tutorIds == resource.data.tutorIds &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'sessionReportUrl', 'sessionReportStoragePath', 'sessionReportFileName',
            'sessionReportUploadedAt', 'sessionReportUploadedBy', 'updatedAt'
          ]);
      }

      function isValidWritingCenterStatus(s) {
        return s in ['PENDING', 'ACCEPTED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'];
      }

      function isWritingCenterTutor() {
        return isAuthenticated() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              (
                writingCenterRoleField() == 'tutor' ||
                writingCenterUserRole() in ['tutor', 'TUTOR', 'teacher', 'TEACHER', 'admin', 'ADMIN']
              );
      }

      // Writing Center sessions
      match /sessions/{sessionId} {
        allow read: if isAuthenticated() && (
                        resource.data.studentId == request.auth.uid ||
                        resource.data.tutorId == request.auth.uid ||
                        (resource.data.tutorIds is list &&
                          request.auth.uid in resource.data.tutorIds) ||
                        resource.data.teacherId == request.auth.uid ||
                        resource.data.status == 'PENDING' ||
                        isWritingCenterTutor() ||
                        isAnyAdmin()
                      );

        allow create: if isAdminMiniLessonCreate() ||
                        (isAuthenticated() &&
                        request.resource.data.keys().hasAll([
                          'studentId', 'studentName', 'studentEmail', 'subject', 'notes',
                          'sessionType', 'status', 'createdAt', 'updatedAt'
                        ]) &&
                        request.resource.data.studentId == request.auth.uid &&
                        request.resource.data.studentName is string &&
                        request.resource.data.studentName.size() > 0 &&
                        request.resource.data.studentEmail is string &&
                        request.resource.data.subject is string &&
                        request.resource.data.subject.size() > 0 &&
                        request.resource.data.notes is string &&
                        isValidWritingCenterSessionType(request.resource.data.sessionType) &&
                        request.resource.data.status == 'PENDING' &&
                        isWritingCenterTimestamp(request.resource.data.createdAt) &&
                        isWritingCenterTimestamp(request.resource.data.updatedAt));

        allow update: if isAuthenticated() && (
                          (resource.data.studentId == request.auth.uid &&
                            request.resource.data.studentId == resource.data.studentId) ||
                          (resource.data.tutorId == request.auth.uid &&
                            request.resource.data.tutorId == resource.data.tutorId &&
                            resource.data.sessionType != 'MINI_LESSON') ||
                          (isWritingCenterTutor() &&
                            resource.data.status == 'PENDING' &&
                            request.resource.data.tutorId == request.auth.uid) ||
                          isMiniLessonTeacherReportUpdate() ||
                          isAnyAdmin()
                        );

        allow delete: if isAuthenticated() && (
                          resource.data.studentId == request.auth.uid ||
                          isAnyAdmin()
                        );
      }

      // Writing Center receipts shared with teachers
      match /writingCenterReceiptShares/{shareId} {
        allow read: if isAuthenticated() && (
                          resource.data.teacherId == request.auth.uid ||
                          resource.data.studentId == request.auth.uid ||
                          isAnyAdmin()
                        );

        allow create, update: if isAuthenticated() &&
                                request.resource.data.keys().hasAll([
                                  'sessionId', 'studentId', 'teacherId',
                                  'sessionReportUrl', 'sharedAt', 'sharedBy'
                                ]) &&
                                request.resource.data.studentId == request.auth.uid &&
                                request.resource.data.sharedBy == request.auth.uid &&
                                request.resource.data.sessionId is string &&
                                request.resource.data.sessionId.size() > 0 &&
                                request.resource.data.teacherId is string &&
                                request.resource.data.teacherId.size() > 0 &&
                                request.resource.data.sessionReportUrl is string &&
                                request.resource.data.sessionReportUrl.size() > 0 &&
                                request.resource.data.sharedAt is timestamp &&
                                // Must be sharing their own completed session with a report
                                exists(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)) &&
                                get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.studentId == request.auth.uid &&
                                get(/databases/$(database)/documents/sessions/$(request.resource.data.sessionId)).data.status == 'COMPLETED' &&
                                // Destination must be a teacher account
                                exists(/databases/$(database)/documents/users/$(request.resource.data.teacherId)) &&
                                get(/databases/$(database)/documents/users/$(request.resource.data.teacherId)).data.role in ['teacher', 'TEACHER'];

        allow delete: if isAuthenticated() && (
                          resource.data.studentId == request.auth.uid ||
                          isAnyAdmin()
                        );
      }

      // Office Hour Scheduler
      match /officeHourSlots/{slotId} {
        allow read: if isAuthenticated();

        allow create: if isSlotHost() &&
                        request.resource.data.keys().hasAll([
                          'hostId', 'hostName', 'slotType', 'course', 'startAt', 'endAt',
                          'maxCapacity', 'bookedCount', 'status', 'createdAt', 'updatedAt'
                        ]) &&
                        request.resource.data.hostId == request.auth.uid &&
                        request.resource.data.hostName is string &&
                        request.resource.data.slotType == 'office_hours' &&
                        request.resource.data.course is string &&
                        request.resource.data.startAt is timestamp &&
                        request.resource.data.endAt is timestamp &&
                        request.resource.data.maxCapacity is int &&
                        request.resource.data.maxCapacity >= 1 &&
                        request.resource.data.maxCapacity <= 50 &&
                        request.resource.data.bookedCount == 0 &&
                        request.resource.data.status == 'open' &&
                        (!('signupCloseMinutes' in request.resource.data) ||
                          (request.resource.data.signupCloseMinutes is int &&
                          request.resource.data.signupCloseMinutes >= 0 &&
                          request.resource.data.signupCloseMinutes <= 10080)) &&
                        request.resource.data.createdAt is timestamp &&
                        request.resource.data.updatedAt is timestamp;

        allow update: if isAuthenticated() &&
                        resource.data.hostId == request.auth.uid &&
                        request.resource.data.hostId == resource.data.hostId &&
                        request.resource.data.bookedCount == resource.data.bookedCount &&
                        isValidSlotStatus(request.resource.data.status);

        allow update: if isAuthenticated() &&
                        request.resource.data.bookedCount == resource.data.bookedCount + 1 &&
                        request.resource.data.bookedCount <= request.resource.data.maxCapacity &&
                        request.resource.data.status in ['open', 'full'];

        allow update: if isAuthenticated() &&
                        request.resource.data.bookedCount == resource.data.bookedCount - 1 &&
                        request.resource.data.bookedCount >= 0 &&
                        request.resource.data.status in ['open', 'full'];

        allow delete: if isAuthenticated() &&
                        resource.data.hostId == request.auth.uid &&
                        resource.data.bookedCount == 0;
      }
