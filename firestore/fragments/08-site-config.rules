
      match /siteConfig/signupAllowlist {
        allow read: if true;
        allow create, update: if isSiteAdmin() &&
                                request.resource.data.emailAllowlist is map &&
                                request.resource.data.emailAllowlist.size() <= 200 &&
                                request.resource.data.updatedAt is timestamp &&
                                request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isSiteAdmin();
      }
