
      // Club Hub access contract: client UI may use live clubHubSponsors overrides;
      // Firestore writes require synced clubHubAccess (directoryClubSlugs / manualClubSlugs).

      function clubHubAccessDocPath(email) {
        return /databases/$(database)/documents/clubHubAccess/$(normalizeEmail(email));
      }

      function clubHubAccessForAuthUser() {
        return get(clubHubAccessDocPath(request.auth.token.email)).data;
      }

      function clubHubSlugAllowedInMap(slugMap, slug) {
        return slugMap is map &&
              slug in slugMap &&
              slugMap[slug] == true;
      }

      function isClubHubCoordinatorAccess() {
        return isAuthenticated() &&
              request.auth.token.email is string &&
              exists(clubHubAccessDocPath(request.auth.token.email)) &&
              clubHubAccessForAuthUser().isCoordinator == true;
      }

      function isClubHubAdmin() {
        return isSiteAdmin() || isClubHubCoordinatorAccess();
      }

      function canEditClubHubPage(slug) {
        return isClubHubAdmin() ||
              (isAuthenticated() &&
                request.auth.token.email is string &&
                exists(clubHubAccessDocPath(request.auth.token.email)) &&
                (
                  clubHubSlugAllowedInMap(clubHubAccessForAuthUser().get('directoryClubSlugs', {}), slug) ||
                  clubHubSlugAllowedInMap(clubHubAccessForAuthUser().get('manualClubSlugs', {}), slug) ||
                  clubHubSlugAllowedInMap(clubHubAccessForAuthUser().get('boardClubSlugs', {}), slug) ||
                  clubHubSlugAllowedInMap(clubHubAccessForAuthUser().get('clubSlugs', {}), slug)
                ));
      }

      function isValidClubHubSlugMap(field) {
        return field is map && field.size() <= 120;
      }

      function isValidClubHubAccessWrite(emailKey) {
        return request.resource.data.email is string &&
              isValidEmail(request.resource.data.email) &&
              request.resource.data.email == normalizeEmail(request.resource.data.email) &&
              normalizeEmail(request.resource.data.email) == normalizeEmail(emailKey) &&
              request.resource.data.isCoordinator is bool &&
              isValidClubHubSlugMap(request.resource.data.get('manualClubSlugs', {})) &&
              isValidClubHubSlugMap(request.resource.data.get('directoryClubSlugs', {})) &&
              isValidClubHubSlugMap(request.resource.data.get('boardClubSlugs', {})) &&
              request.resource.data.updatedAt is timestamp &&
              request.resource.data.updatedBy == request.auth.uid;
      }

      match /clubHubSponsors/{slug} {
        allow read: if true;
        allow create, update: if isClubHubAdmin() &&
                                request.resource.data.slug == slug &&
                                request.resource.data.slug is string &&
                                request.resource.data.slug.size() > 0 &&
                                request.resource.data.slug.size() <= 120 &&
                                request.resource.data.clubName is string &&
                                request.resource.data.clubName.size() > 0 &&
                                request.resource.data.clubName.size() <= 120 &&
                                request.resource.data.sponsors is list &&
                                request.resource.data.sponsors.size() <= 10 &&
                                request.resource.data.updatedAt is timestamp &&
                                request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isClubHubAdmin();
      }

      match /clubHubMeetingDays/{slug} {
        allow read: if true;
        allow create, update: if isClubHubAdmin() &&
                                request.resource.data.keys().hasOnly(
                                  ['slug', 'clubName', 'meetingDay', 'updatedAt', 'updatedBy']) &&
                                request.resource.data.slug == slug &&
                                request.resource.data.slug is string &&
                                request.resource.data.slug.size() > 0 &&
                                request.resource.data.slug.size() <= 120 &&
                                request.resource.data.clubName is string &&
                                request.resource.data.clubName.size() <= 120 &&
                                request.resource.data.meetingDay in ['gold', 'maroon', 'both', 'general'] &&
                                request.resource.data.updatedAt is timestamp &&
                                request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isClubHubAdmin();
      }

      // Home page Engagement / Volunteer top-3 (admin-set). Writes go through Admin SDK API.
      match /clubHubManualRankings/{kind} {
        allow read: if true;
        allow write: if false;
      }

      match /clubHubCustomClubs/{slug} {
        allow read: if true;
        allow create, update: if isClubHubAdmin() &&
                                request.resource.data.slug == slug &&
                                request.resource.data.slug is string &&
                                request.resource.data.slug.size() > 0 &&
                                request.resource.data.slug.size() <= 120 &&
                                request.resource.data.name is string &&
                                request.resource.data.name.size() > 0 &&
                                request.resource.data.name.size() <= 120 &&
                                request.resource.data.meetingDay in ['gold', 'maroon', 'both', 'general'] &&
                                request.resource.data.sponsors is list &&
                                request.resource.data.sponsors.size() > 0 &&
                                request.resource.data.sponsors.size() <= 8 &&
                                request.resource.data.updatedAt is timestamp &&
                                request.resource.data.updatedBy == request.auth.uid;
        allow delete: if isClubHubAdmin();
      }

      match /clubHubRemovedClubs/{slug} {
        allow read: if true;
        allow create, update: if isClubHubAdmin() &&
                                request.resource.data.keys().hasOnly(
                                  ['slug', 'name', 'removedAt', 'removedBy']) &&
                                request.resource.data.slug == slug &&
                                request.resource.data.slug is string &&
                                request.resource.data.slug.size() > 0 &&
                                request.resource.data.slug.size() <= 120 &&
                                request.resource.data.name is string &&
                                request.resource.data.name.size() > 0 &&
                                request.resource.data.name.size() <= 120 &&
                                request.resource.data.removedAt is timestamp &&
                                request.resource.data.removedBy == request.auth.uid;
        allow delete: if isClubHubAdmin();
      }

      match /clubHubAccess/{emailKey} {
        allow read: if isAuthenticated() && (
          isClubHubAdmin() ||
          emailsMatch(request.auth.token.email, emailKey)
        );
        allow create, update: if isClubHubAdmin() && isValidClubHubAccessWrite(emailKey);
        allow delete: if isClubHubAdmin();
      }

      match /clubHubBoardMembers/{clubSlug} {
        allow read: if canEditClubHubPage(clubSlug);
        allow write: if false;
      }

      match /clubHubBoardMembersByEmail/{emailKey} {
        allow read: if isClubHubAdmin();
        allow write: if false;
      }

      // Club Hub editable page copy
      match /clubHubPages/{slug} {
        allow read: if true;
        allow create, update: if canEditClubHubPage(slug) &&
                                request.resource.data.keys().hasAll([
                                  'slug', 'about', 'updatedAt', 'updatedBy'
                                ]) &&
                                request.resource.data.slug == slug &&
                                request.resource.data.slug is string &&
                                request.resource.data.slug.size() > 0 &&
                                request.resource.data.slug.size() <= 120 &&
                                request.resource.data.about is string &&
                                request.resource.data.about.size() > 0 &&
                                request.resource.data.about.size() <= 4000 &&
                                request.resource.data.updatedAt is timestamp &&
                                request.resource.data.updatedBy == request.auth.uid &&
                                (!('resourcesUrl' in request.resource.data) ||
                                  (request.resource.data.resourcesUrl is string &&
                                    request.resource.data.resourcesUrl.size() <= 500)) &&
                                (!('resourcesLabel' in request.resource.data) ||
                                  (request.resource.data.resourcesLabel is string &&
                                    request.resource.data.resourcesLabel.size() <= 80)) &&
                                (!('clubLeaders' in request.resource.data) ||
                                  (request.resource.data.clubLeaders is string &&
                                    request.resource.data.clubLeaders.size() <= 500)) &&
                                (!('facultyAdvisor' in request.resource.data) ||
                                  (request.resource.data.facultyAdvisor is string &&
                                    request.resource.data.facultyAdvisor.size() <= 500)) &&
                                (!('contactEmails' in request.resource.data) ||
                                  (request.resource.data.contactEmails is string &&
                                    request.resource.data.contactEmails.size() <= 1000)) &&
                                (!('meetingFrequency' in request.resource.data) ||
                                  (request.resource.data.meetingFrequency is string &&
                                    request.resource.data.meetingFrequency.size() <= 200)) &&
                                (!('memberCount' in request.resource.data) ||
                                  (request.resource.data.memberCount is string &&
                                    request.resource.data.memberCount.size() <= 40)) &&
                                (!('headerImageUrl' in request.resource.data) ||
                                  (request.resource.data.headerImageUrl is string &&
                                    request.resource.data.headerImageUrl.size() <= 2000)) &&
                                (!('memberSignupLimit' in request.resource.data) ||
                                  request.resource.data.memberSignupLimit == null ||
                                  (request.resource.data.memberSignupLimit is int &&
                                    request.resource.data.memberSignupLimit >= 1 &&
                                    request.resource.data.memberSignupLimit <= 5000)) &&
                                (!('joinPolicy' in request.resource.data) ||
                                  request.resource.data.joinPolicy == 'open' ||
                                  request.resource.data.joinPolicy == 'approval');
        allow delete: if isClubHubAdmin();
      }

      function clubHubMemberSignupLimitForSlug(clubSlug) {
        let pagePath = /databases/$(database)/documents/clubHubPages/$(clubSlug);
        return exists(pagePath) &&
               ('memberSignupLimit' in get(pagePath).data) &&
               get(pagePath).data.memberSignupLimit is int &&
               get(pagePath).data.memberSignupLimit >= 1
               ? get(pagePath).data.memberSignupLimit
               : null;
      }

      function clubHubHasMemberSignupLimit(clubSlug) {
        return clubHubMemberSignupLimitForSlug(clubSlug) != null;
      }

      function clubHubMembershipCountForSlug(clubSlug) {
        let countPath = /databases/$(database)/documents/clubHubMembershipCounts/$(clubSlug);
        return exists(countPath) ? get(countPath).data.memberCount : 0;
      }

      function clubHubCanAcceptNewMember(clubSlug) {
        return !clubHubHasMemberSignupLimit(clubSlug) ||
               clubHubMembershipCountForSlug(clubSlug) < clubHubMemberSignupLimitForSlug(clubSlug);
      }

      function clubHubJoinRequiresApproval(clubSlug) {
        let pagePath = /databases/$(database)/documents/clubHubPages/$(clubSlug);
        return exists(pagePath) && get(pagePath).data.get('joinPolicy', 'open') == 'approval';
      }

      function clubHubMembershipCountIncrementAllowed(clubSlug, newCount) {
        return !clubHubHasMemberSignupLimit(clubSlug) ||
               newCount <= clubHubMemberSignupLimitForSlug(clubSlug);
      }

      function isValidClubHubEventWrite() {
        return request.resource.data.clubSlug is string &&
              request.resource.data.clubSlug.size() > 0 &&
              request.resource.data.clubSlug.size() <= 120 &&
              request.resource.data.clubName is string &&
              request.resource.data.clubName.size() > 0 &&
              request.resource.data.clubName.size() <= 120 &&
              request.resource.data.title is string &&
              request.resource.data.title.size() > 0 &&
              request.resource.data.title.size() <= 120 &&
              request.resource.data.date is string &&
              request.resource.data.date.size() == 10 &&
              request.resource.data.time is string &&
              request.resource.data.time.size() > 0 &&
              request.resource.data.time.size() <= 40 &&
              (!('description' in request.resource.data) ||
                (request.resource.data.description is string &&
                  request.resource.data.description.size() <= 500)) &&
              (!('location' in request.resource.data) ||
                (request.resource.data.location is string &&
                  request.resource.data.location.size() <= 120)) &&
              request.resource.data.updatedAt is timestamp &&
              request.resource.data.updatedBy == request.auth.uid;
      }

      match /clubHubEvents/{eventId} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        isValidClubHubEventWrite() &&
                        canEditClubHubPage(request.resource.data.clubSlug) &&
                        request.resource.data.createdAt is timestamp &&
                        request.resource.data.createdBy == request.auth.uid;
        allow update: if isAuthenticated() &&
                        isValidClubHubEventWrite() &&
                        canEditClubHubPage(resource.data.clubSlug) &&
                        request.resource.data.clubSlug == resource.data.clubSlug &&
                        request.resource.data.createdAt == resource.data.createdAt &&
                        request.resource.data.createdBy == resource.data.createdBy;
        allow delete: if isAuthenticated() &&
                        canEditClubHubPage(resource.data.clubSlug);
      }

      function isValidClubHubSeminarDays(value) {
        return value is list &&
              value.size() <= 2 &&
              value.hasOnly(['gold', 'maroon']);
      }

      function isValidClubHubMembershipWrite() {
        return request.resource.data.clubSlug is string &&
              request.resource.data.clubSlug.size() > 0 &&
              request.resource.data.clubSlug.size() <= 120 &&
              request.resource.data.clubName is string &&
              request.resource.data.clubName.size() > 0 &&
              request.resource.data.clubName.size() <= 120 &&
              request.resource.data.userId is string &&
              request.resource.data.userId == request.auth.uid &&
              request.resource.data.userEmail is string &&
              request.resource.data.userEmail.size() > 0 &&
              request.resource.data.userEmail.size() <= 128 &&
              request.resource.data.userEmail == normalizeEmail(request.resource.data.userEmail) &&
              emailsMatch(request.resource.data.userEmail, request.auth.token.email) &&
              request.resource.data.displayName is string &&
              request.resource.data.displayName.size() > 0 &&
              request.resource.data.displayName.size() <= 100 &&
              request.resource.data.joinedAt is timestamp &&
              (!('seminarDays' in request.resource.data) ||
                isValidClubHubSeminarDays(request.resource.data.seminarDays));
      }

      function clubHubMembershipDocIdForWrite() {
        return request.resource.data.clubSlug + '__' + request.auth.uid;
      }

      function clubHubMembershipIdForAuthUser(membershipId) {
        return membershipId.matches('^.+__' + request.auth.uid + '$');
      }

      match /clubHubMemberships/{membershipId} {
        // Own doc get must work when the membership doc does not exist yet (pre-join).
        allow get: if isAuthenticated() && (
          clubHubMembershipIdForAuthUser(membershipId) ||
          isClubHubAdmin() ||
          (resource != null && canEditClubHubPage(resource.data.clubSlug))
        );
        allow list: if isAuthenticated() && (
          isClubHubAdmin() ||
          resource.data.userId == request.auth.uid ||
          canEditClubHubPage(resource.data.clubSlug)
        );
        allow create: if isAuthenticated() &&
                        membershipId == clubHubMembershipDocIdForWrite() &&
                        isValidClubHubMembershipWrite() &&
                        clubHubCanAcceptNewMember(request.resource.data.clubSlug) &&
                        !clubHubJoinRequiresApproval(request.resource.data.clubSlug) &&
                        !clubHubJoinRequiresBoardInvite(request.resource.data.clubSlug);
        allow update: if isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        request.resource.data.userId == resource.data.userId &&
                        request.resource.data.clubSlug == resource.data.clubSlug &&
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['seminarDays', 'updatedAt']) &&
                        isValidClubHubSeminarDays(request.resource.data.seminarDays) &&
                        request.resource.data.seminarDays.size() > 0 &&
                        request.resource.data.updatedAt is timestamp;
        allow delete: if isAuthenticated() &&
                        resource.data.userId == request.auth.uid;
      }

      function isValidClubHubJoinRequestCreate() {
        return request.resource.data.clubSlug is string &&
              request.resource.data.clubSlug.size() > 0 &&
              request.resource.data.clubSlug.size() <= 120 &&
              request.resource.data.clubName is string &&
              request.resource.data.clubName.size() > 0 &&
              request.resource.data.clubName.size() <= 120 &&
              request.resource.data.userId is string &&
              request.resource.data.userId == request.auth.uid &&
              request.resource.data.userEmail is string &&
              request.resource.data.userEmail.size() > 0 &&
              request.resource.data.userEmail.size() <= 128 &&
              request.resource.data.userEmail == normalizeEmail(request.resource.data.userEmail) &&
              emailsMatch(request.resource.data.userEmail, request.auth.token.email) &&
              request.resource.data.displayName is string &&
              request.resource.data.displayName.size() > 0 &&
              request.resource.data.displayName.size() <= 100 &&
              request.resource.data.status == 'pending' &&
              request.resource.data.requestedAt is timestamp &&
              clubHubJoinRequiresApproval(request.resource.data.clubSlug) &&
              clubHubCanAcceptNewMember(request.resource.data.clubSlug) &&
              !clubHubJoinRequiresBoardInvite(request.resource.data.clubSlug) &&
              !exists(/databases/$(database)/documents/clubHubMemberships/$(request.resource.data.clubSlug + '__' + request.auth.uid));
      }

      match /clubHubJoinRequests/{requestId} {
        allow get: if isAuthenticated() && (
          requestId.matches('^.+__' + request.auth.uid + '$') ||
          (resource != null && canEditClubHubPage(resource.data.clubSlug))
        );
        allow list: if isAuthenticated() && (
          resource.data.userId == request.auth.uid ||
          canEditClubHubPage(resource.data.clubSlug)
        );
        allow create: if isAuthenticated() &&
                        requestId == request.resource.data.clubSlug + '__' + request.auth.uid &&
                        isValidClubHubJoinRequestCreate();
        allow update: if false;
        allow delete: if isAuthenticated() &&
                        resource.data.userId == request.auth.uid &&
                        resource.data.status == 'pending';
      }

      function isValidClubHubMembershipCountFields() {
        return request.resource.data.clubSlug is string &&
              request.resource.data.clubSlug.size() > 0 &&
              request.resource.data.clubSlug.size() <= 120 &&
              request.resource.data.clubName is string &&
              request.resource.data.clubName.size() > 0 &&
              request.resource.data.clubName.size() <= 120 &&
              request.resource.data.memberCount is int &&
              request.resource.data.memberCount >= 0 &&
              request.resource.data.memberCount <= 5000 &&
              request.resource.data.updatedAt is timestamp;
      }

      // Keep in sync with lib/club-hub/clubBoardGroups.js (clubRequiresBoardToJoin).
      // Only board-only fair rows (no open Gold/Maroon listing) — sponsor must add.
      // Gold/Maroon seminar slots are derived from clubHubMemberships (+ seminarDays);
      // the old clubHubMeetingChoices collection is no longer used.
      function clubHubJoinRequiresBoardInvite(slug) {
        return slug == 'key-club' ||
               slug == 'interact' ||
               slug == 'national-art-honor-society-nahs';
      }

      match /clubHubMembershipCounts/{slug} {
        allow read: if true;
        allow create: if isAuthenticated() &&
                        request.resource.data.clubSlug == slug &&
                        isValidClubHubMembershipCountFields() &&
                        request.resource.data.memberCount == 1 &&
                        clubHubMembershipCountIncrementAllowed(slug, 1);
        allow update: if isAuthenticated() &&
                        request.resource.data.clubSlug == slug &&
                        isValidClubHubMembershipCountFields() &&
                        (
                          (
                            request.resource.data.memberCount == resource.data.memberCount + 1 &&
                            clubHubMembershipCountIncrementAllowed(slug, request.resource.data.memberCount)
                          ) ||
                          request.resource.data.memberCount == resource.data.memberCount - 1
                        );
        allow delete: if isClubHubAdmin();
      }

      match /clubHubOpportunityEvents/{eventId} {
        allow read: if resource.data.published != false;
        allow write: if false;
      }
