# Copy to .env.local and fill in (never commit .env.local).
#
# Required for Club Hub sponsor sync (/api/club-hub/sync-sponsor-access) and other
# server routes that use Firebase Admin (Writing Center form sync, etc.).
#
# Firebase Console → Project Settings → Service accounts → Generate new private key
# Use the c4cdev project for local dev (matches keys.dev.js).
#
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"c4cdev-6f9f4",...}'
