# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/a11y-report
firestore-debug.log

# next.js
/.next/
/out/

# swc plugin cache (recreated if needed)
.swc/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Local Firebase dev client config (copy from tempkeys.dev.js)
keys.dev.js

# vercel
.vercel

# firebase local cache
.firebase/

# typescript (not used in this project)
# *.tsbuildinfo
# next-env.d.ts